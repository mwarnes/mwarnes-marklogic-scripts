# MarkLogic Certificate Deploy Configuration
#
# This file should be installed to /etc/default/marklogic-cert-deploy
# with restrictive permissions (0600 root:root).
#
# Usage:
#   sudo install -m 0600 -o root -g root marklogic-cert-deploy.env.example \
#     /etc/default/marklogic-cert-deploy
#
# Then edit /etc/default/marklogic-cert-deploy with your actual values.

# MarkLogic Management API connection
ML_HOST=localhost
ML_PORT=8002
ML_SCHEME=https

# MarkLogic authentication (digest/basic)
ML_USER=admin
# Set using a secret manager/editor; the wrapper parses this file without sourcing it.
ML_PASSWORD=

# Certificate template name or id
ML_CERT_TEMPLATE=MarkLogic

# Optional: Custom CA bundle for verifying the Management API's certificate
# Use this when the Management API uses a certificate issued by an internal CA
# that isn't in the system trust store. Leave commented to use system trust store.
# ML_CA_FILE=/path/to/ca-bundle.pem
# ML_BACKUP_DIR=/var/lib/marklogic-cert-deploy/backups

# Optional: Disable TLS verification entirely (TEST ONLY - not for production)
# Use ML_CA_FILE instead whenever the issuing CA is known.
# ML_INSECURE=1
